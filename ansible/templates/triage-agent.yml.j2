---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ triage_namespace }}
  labels:
    purpose: "sre-alert-triage"
---
apiVersion: v1
kind: ResourceQuota
metadata:
  name: triage-quota
  namespace: {{ triage_namespace }}
spec:
  hard:
    pods: "10"
    requests.cpu: "1500m"
    requests.memory: "1536Mi"
    limits.cpu: "3"
    limits.memory: "3Gi"
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: triage-agent
  namespace: {{ triage_namespace }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: prometheus-mcp
  namespace: {{ triage_namespace }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: elasticsearch-mcp
  namespace: {{ triage_namespace }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: kubernetes-mcp
  namespace: {{ triage_namespace }}
---
# Strict Read-Only ClusterRole: NO secrets, NO configmaps, NO mutating verbs.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: obs-triage-reader
rules:
  - apiGroups: [""]
    resources: ["pods", "pods/log", "events", "services", "namespaces"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["apps"]
    resources: ["deployments", "replicasets", "statefulsets", "daemonsets"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: obs-triage-reader-binding
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: obs-triage-reader
subjects:
  - kind: ServiceAccount
    name: kubernetes-mcp
    namespace: {{ triage_namespace }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: triage-reports-pvc
  namespace: {{ triage_namespace }}
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: "{{ storage_class }}"
  resources:
    requests:
      storage: "{{ triage_storage_size }}"
---
# 1. Prometheus MCP Server
apiVersion: apps/v1
kind: Deployment
metadata:
  name: prometheus-mcp
  namespace: {{ triage_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: prometheus-mcp
  template:
    metadata:
      labels:
        app: prometheus-mcp
    spec:
      serviceAccountName: prometheus-mcp
      automountServiceAccountToken: false
      containers:
        - name: prometheus-mcp
          image: "{{ triage_mcp_image }}"
          imagePullPolicy: IfNotPresent
          command: ["python3", "prometheus_mcp.py"]
          ports:
            - containerPort: 8001
          env:
            - name: MCP_PORT
              value: "8001"
            - name: PROMETHEUS_URL
              value: "http://{{ prometheus_service }}.{{ monitoring_namespace }}.svc:{{ prometheus_port }}"
          resources:
            requests: { cpu: "50m", memory: "128Mi" }
            limits:   { cpu: "250m", memory: "256Mi" }
---
apiVersion: v1
kind: Service
metadata:
  name: prometheus-mcp
  namespace: {{ triage_namespace }}
spec:
  selector:
    app: prometheus-mcp
  ports:
    - name: http
      port: 8001
      targetPort: 8001
---
# 2. Elasticsearch MCP Server
apiVersion: apps/v1
kind: Deployment
metadata:
  name: elasticsearch-mcp
  namespace: {{ triage_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: elasticsearch-mcp
  template:
    metadata:
      labels:
        app: elasticsearch-mcp
    spec:
      serviceAccountName: elasticsearch-mcp
      automountServiceAccountToken: false
      containers:
        - name: elasticsearch-mcp
          image: "{{ triage_mcp_image }}"
          imagePullPolicy: IfNotPresent
          command: ["python3", "elasticsearch_mcp.py"]
          ports:
            - containerPort: 8002
          env:
            - name: MCP_PORT
              value: "8002"
            - name: ELASTICSEARCH_URL
              value: "{{ elasticsearch_protocol }}://{{ elasticsearch_service }}.{{ logging_namespace }}.svc:{{ elasticsearch_port }}"
            - name: TRIAGE_ALLOWED_NAMESPACES
              value: "{{ triage_es_allowed_namespaces }}"
            - name: ELASTICSEARCH_USERNAME
              valueFrom:
                secretKeyRef:
                  name: triage-es-credentials
                  key: username
            - name: ELASTICSEARCH_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: triage-es-credentials
                  key: password
          resources:
            requests: { cpu: "50m", memory: "128Mi" }
            limits:   { cpu: "250m", memory: "256Mi" }
---
apiVersion: v1
kind: Service
metadata:
  name: elasticsearch-mcp
  namespace: {{ triage_namespace }}
spec:
  selector:
    app: elasticsearch-mcp
  ports:
    - name: http
      port: 8002
      targetPort: 8002
---
# 3. Kubernetes MCP Server (only pod with K8s API read-only SA token)
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kubernetes-mcp
  namespace: {{ triage_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: kubernetes-mcp
  template:
    metadata:
      labels:
        app: kubernetes-mcp
    spec:
      serviceAccountName: kubernetes-mcp
      containers:
        - name: kubernetes-mcp
          image: "{{ triage_mcp_image }}"
          imagePullPolicy: IfNotPresent
          command: ["python3", "kubernetes_mcp.py"]
          ports:
            - containerPort: 8003
          env:
            - name: MCP_PORT
              value: "8003"
            - name: TRIAGE_ALLOWED_NAMESPACES
              value: "{{ triage_allowed_namespaces }}"
          resources:
            requests: { cpu: "50m", memory: "128Mi" }
            limits:   { cpu: "250m", memory: "256Mi" }
---
apiVersion: v1
kind: Service
metadata:
  name: kubernetes-mcp
  namespace: {{ triage_namespace }}
spec:
  selector:
    app: kubernetes-mcp
  ports:
    - name: http
      port: 8003
      targetPort: 8003
---
# 4. Triage Agent (FastAPI + OpenAI Agents SDK)
apiVersion: apps/v1
kind: Deployment
metadata:
  name: triage-agent
  namespace: {{ triage_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: triage-agent
  template:
    metadata:
      labels:
        app: triage-agent
    spec:
      serviceAccountName: triage-agent
      automountServiceAccountToken: false
      containers:
        - name: triage-agent
          image: "{{ triage_agent_image }}"
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: TRIAGE_LLM_BASE_URL
              value: "{{ triage_llm_base_url }}"
            - name: TRIAGE_LLM_MODEL
              value: "{{ triage_llm_model }}"
            - name: TRIAGE_LLM_API_KEY
              valueFrom:
                secretKeyRef:
                  name: triage-llm-credentials
                  key: api_key
            - name: PROMETHEUS_MCP_URL
              value: "http://prometheus-mcp.{{ triage_namespace }}.svc:8001/mcp"
            - name: ELASTICSEARCH_MCP_URL
              value: "http://elasticsearch-mcp.{{ triage_namespace }}.svc:8002/mcp"
            - name: KUBERNETES_MCP_URL
              value: "http://kubernetes-mcp.{{ triage_namespace }}.svc:8003/mcp"
            - name: TRIAGE_MAX_TOOL_CALLS
              value: "{{ triage_max_tool_calls }}"
            - name: TRIAGE_COOLDOWN_MINUTES
              value: "{{ triage_cooldown_minutes }}"
            - name: TRIAGE_RUNBOOKS_DIR
              value: "/etc/triage-runbooks"
            - name: TRIAGE_OUTPUT_DIR
              value: "/data/triage"
          volumeMounts:
            - name: runbooks
              mountPath: /etc/triage-runbooks
              readOnly: true
            - name: reports
              mountPath: /data/triage
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 20
            periodSeconds: 20
          resources:
            requests: { cpu: "100m", memory: "256Mi" }
            limits:   { cpu: "500m", memory: "512Mi" }
      volumes:
        - name: runbooks
          configMap:
            name: triage-runbooks
        - name: reports
          persistentVolumeClaim:
            claimName: triage-reports-pvc
---
apiVersion: v1
kind: Service
metadata:
  name: triage-agent
  namespace: {{ triage_namespace }}
  labels:
    app: triage-agent
spec:
  selector:
    app: triage-agent
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: triage-agent
  namespace: {{ monitoring_namespace }}
  labels:
    release: {{ kube_prometheus_release }}
spec:
  namespaceSelector:
    matchNames:
      - {{ triage_namespace }}
  selector:
    matchLabels:
      app: triage-agent
  endpoints:
    - port: http
      path: /metrics
      interval: 30s
